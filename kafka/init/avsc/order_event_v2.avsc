{
  "type": "record",
  "name": "OrderEvent",
  "namespace": "local_data_platform", // FQN
  "doc": "受注ストリーム (orders_microbatch)",

  "x-slo": {
    "latency_sec": 600,          // 10 min 以内に到着
    "completeness_pct": 99.0,    // 1 hウィンドウ欠損 ≤1 %
    "error_budget_hours": 4      // 月間許容 4 h
  },

  "x-change_policy": {
    "notice_days": 30,           // 30 日前までに告知
    "dual_publish_days": 60     // v1 と併走 60 日
  },

  "x-remediation": {
    "owner": "orders-app-team",
    "fix_within_hours": 24,
    "notify_slack": "#orders-data-notify"
  },
  
  "fields": [
    /* ─────────── IDs ─────────── */
    {
      "name": "id",
      "type": "string",
      "doc" : "UUID v4",
      "x-regex": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },

    /* ─────────── User / Product ─────────── */
    { "name": "user_id",    "type": "int", "doc": "ユーザーID" },
    { "name": "product_id", "type": "int", "doc": "製品ID" },

    /* ─────────── 金額 (decimal) ─────────── */
    { "name": "subtotal_usd", "type": "double" },
    { "name": "tax_usd",      "type": "double" },
    { "name": "total_usd",       "type": "double", "cuallee:rule": "self == $.subtotal_usd + $.tax_usd" },

    /* ─────────── 個数 & フラグ ─────────── */
    { "name": "quantity", "type": "int", "doc": "数量（個）" },

    {
      "name": "status_flag",
      "type": {                /* Avro enum = 値集合を強制できる */
        "type": "enum",
        "name": "OrderFlag",
        "symbols": ["FLAG_0", "FLAG_1"]
      },
      "doc": "NORMAL=通常, CANCEL=取消"
    },

    /* ─────────── 生成時刻 ─────────── */
    { "name": "created_at",
      "type": { "type":"long","logicalType":"timestamp-millis" },
      "doc": "UTCミリ秒",
      "cuallee:rule": "self >= now() - 600000" 
    },

    { "name": "parent_id",
      "type": ["null","string"],         // ← null 許可
      "default": null,                   // ← V1が書き込む時は
      "doc": "親注文 ID"
    }

  ]
}
