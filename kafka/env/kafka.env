# Zookeeper Connect
KAFKA_ZOOKEEPER_CONNECT: zookeeper1.local.data.platform:2181

# Client設定
KAFKA_INTER_BROKER_LISTENER_NAME: CLIENT_SASL_SSL
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CLIENT_SASL_SSL:SASL_SSL,CLIENT_SASL_PLAINTEXT:SASL_PLAINTEXT,CLIENT_OAUTH_SSL:SASL_SSL

# Security共通
KAFKA_SASL_ENABLED_MECHANISMS: OAUTHBEARER,PLAIN
KAFKA_OPTS: "-Djava.security.auth.login.config=/opt/kafka/jaas.conf"

# 個別のチューニング設定
# https://stackoverflow.com/questions/77802243/kafka-raft-sasl-ssl-client-failing-to-initialize
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 2
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 2
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 2
# パーティション数は2
KAFKA_NUM_PARTITIONS: 2
KAFKA_AUTO_CREATE_TOPICS_ENABLE: 'false'
KAFKA_HEAP_OPTS="-Xms6g -Xmx6g -XX:MetaspaceSize=96m -XX:+UseG1GC -XX:MaxGCPauseMillis=20 -XX:InitiatingHeapOccupancyPercent=35 -XX:G1HeapRegionSize=16M -XX:MinMetaspaceFreeRatio=50 -XX:MaxMetaspaceFreeRatio=80"
#KAFKA_NUM_IO_THREADS="16"
#KAFKA_NUM_NETWORK_THREADS="8"
KAFKA_REPLICA_FETCH_WAIT_MAX_MS="5000"
# 7日間
KAFKA_LOG_RETENTION_HOURS: 168
# 1GB
KAFKA_LOG_RETENTION_BYTES: 1073741824
KAFKA_LOG_SEGMENT_BYTES: 1073741824
KAFKA_LOG_CLEANUP_POLICY: delete

# broker間設定
KAFKA_SASL_MECHANISM_INTER_BROKER_PROTOCOL: PLAIN
#KAFKA_SASL_MECHANISM_INTER_BROKER_PROTOCOL: OAUTHBEARER


# SSL
#KAFKA_SASL_MECHANISM: OAUTHBEARER
## ホスト名(証明書のCNとホスト名が本来は一致していなければならない)をOFFに、ホスト名の検証をONにする場合はhttpsを設定する
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM: https
## クライアント認証が必要かどうか。required, requested, none
KAFKA_SSL_CLIENT_AUTH: required

## keystore for SSL
KAFKA_SSL_KEYSTORE_CREDENTIALS = ssl/kafka_keystore_creds
KAFKA_SSL_KEY_CREDENTIALS = ssl/kafka_sslkey_creds
KAFKA_SSL_TRUSTSTORE_FILENAME = ssl/kafka.truststore.jks
KAFKA_SSL_TRUSTSTORE_CREDENTIALS = ssl/kafka_truststore_creds

# OauthBearer
## https://docs.redhat.com/ja/documentation/red_hat_amq/2021.q2/html/using_amq_streams_on_rhel/oauth_2_0_authentication_configuration_in_the_kafka_cluster#oauth_2_0_authentication_configuration_in_the_kafka_cluster
KAFKA_SASL_OAUTHBEARER_TOKEN_ENDPOINT_URL: http://keycloak:8080/realms/openldap/protocol/openid-connect/token
KAFKA_SASL_OAUTHBEARER_JWKS_ENDPOINT_URL: http://keycloak:8080/realms/openldap/protocol/openid-connect/certs

#KAFKA_SASL_OAUTHBEARER_VALIDATOR_CALLBACK_HANDLER_CLASS = org.apache.kafka.common.security.oauthbearer.OAuthBearerValidatorCallbackHandler
#KAFKA_OAUTH_ISSUER = http://keycloak:8080/auth/realms/openldap
#KAFKA_OAUTH_JWKS_ENDPOINT_URI = http://keycloak:8080/realms/openldap/protocol/openid-connect/certs

## NAME_${CLINET_NAME}...
KAFKA_SASL_LOGIN_CALLBACK_HANDLER_CLASS: org.apache.kafka.common.security.oauthbearer.secured.OAuthBearerLoginCallbackHandler
KAFKA_SASL_SERVER_CALLBACK_HANDLER_CLASS: org.apache.kafka.common.security.oauthbearer.secured.OAuthBearerValidatorCallbackHandler
#KAFKA_CONNECTIONS_MAX_REAUTH_MS: 3600000

# Logger
KAFKA_LOG4J_LOGGERS: "DEBUG, console, kafkaAppender,kafka.controller=DEBUG,kafka.producer.async=DEBUG,state.change.logger=DEBUG,org.apache.kafka.common.security.oauthbearer=DEBUG,log4j.logger.org.apache.kafka.common.network.SaslChannelBuilder=DEBUG,log4j.logger.org.apache.kafka.common.security.authenticator.AbstractLogin=DEBUG"
## 監査ログ
#KAFKA_AUTHORIZER_CLASS_NAME: kafka.security.authorizer.AclAuthorizer


# ACL
KAFKA_AUTHORIZER_CLASS_NAME: kafka.security.authorizer.AclAuthorizer
KAFKA_ALLOW_EVERYONE_IF_NO_ACL_FOUND: "false"
## スーパーユーザ
KAFKA_SUPER_USERS: "User:admin"